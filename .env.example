# Safe development template. Never commit a real .env or paste production secrets here.
# Create a private .env with `pnpm setup:local`, then set MONGODB_URI and JWT_SECRET.

# Node/API
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173

# MongoDB: use a replica set or Atlas (transactions are required).
# Leave empty only until you have configured your own local replica-set URI.
MONGODB_URI=
MONGODB_DATABASE=nuvia_development

# Generate at least 32 random characters, e.g. `openssl rand -hex 48`.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters

# Mail: file mode writes private recovery links to .local/mail (no inbox delivery).
MAIL_MODE=file
# To use SMTP instead, set MAIL_MODE=smtp and configure all of the following:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_FROM=

# AI service (optional; disabled unless configured and credentials are supplied).
# Local pnpm dev:
AI_SERVICE_URL=http://127.0.0.1:8000
# Docker Compose override (the API container reaches the AI service by service name):
AI_CONTAINER_SERVICE_URL=http://ai:8000
# Must match apps/ai-service configuration; generate a separate random token.
AI_SERVICE_TOKEN=
AI_REQUEST_TIMEOUT_MS=190000
AI_BATCH_SIZE=5
AI_POLL_MS=2000
AI_STALE_MS=300000
AI_BASELINE_MODE=false
AI_ASSISTANT_PROVIDER=disabled
AI_SUMMARY_PROVIDER=disabled

# Optional summary/assistant providers (never send keys to local workers):
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=
AI_GROQ_API_KEY=
AI_GROQ_MODEL=
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=
AI_OLLAMA_API_KEY=
AI_ASSISTANT_MODEL=openai/gpt-oss-120b
AI_ASSISTANT_API_KEY=
AI_ASSISTANT_OUTPUT_TOKENS=2048

# Optional public survey link base and security settings.
# Backend-only: live share endpoints are not enabled, and this value does not
# currently change any API response. Connected frontend survey links are built
# from the exact browser origin to preserve Origin/CSRF; never serve a linked
# public survey from localhost when APP_ORIGIN is 127.0.0.1 (or vice versa).
SURVEY_LINK_BASE_URL=
TWO_FACTOR_KEY=

# Optional local test/tooling overrides (never point these at customer databases).
MONGOMS_VERSION=7.0.24
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
