# Copy to root .env and supply private values. Never commit .env.
MONGODB_URI=
MONGODB_DATABASE=nuvia
# Required: generate a random secret of at least 32 characters.
JWT_SECRET=
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
HOST=127.0.0.1
MAIL_MODE=file
# Real mail requires explicit provider configuration and acceptance testing.
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Public web configuration only (never credentials).
NUVIA_API_TARGET=http://127.0.0.1:3001
VITE_PUBLIC_SURVEY_URL=https://nuvia.link/bloom-feedback

# Optional private AI settings. Preserve existing JWT/database values.
# Generate a random hex service token of at least 32 characters. Empty disables AI.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=
AI_REQUEST_TIMEOUT_MS=190000
AI_MODEL_ROOT=.local/models
AI_DEVICE=cpu
AI_TASK_TIMEOUT_SECONDS=180
AI_MAX_INPUT_TOKENS=4096
AI_MAX_OUTPUT_TOKENS=768
AI_SENTIMENT_THRESHOLD=0.7
# Explicit experimental opt-in for configured local AI operations; does not claim quality acceptance.
AI_BASELINE_MODE=false
# Summary-only providers: disabled until comparison + reviewed acceptance.
# Qwen summaries are available only in the comparison CLI.
AI_SUMMARY_PROVIDER=disabled
AI_SUMMARY_OUTPUT_TOKENS=2048
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=
AI_GROQ_API_KEY=
AI_GROQ_MODEL=
AI_OLLAMA_URL=http://127.0.0.1:11434
AI_OLLAMA_MODEL=
# Optional for an explicitly configured authenticated Ollama server.
AI_OLLAMA_API_KEY=
# Comparison-only pacing and bounded retries; actual service limits may differ.
AI_COMPARE_MAX_ATTEMPTS=4
AI_COMPARE_MAX_WAIT_SECONDS=120
AI_COMPARE_RUN_BUDGET_SECONDS=900
AI_COMPARE_GEMINI_RPM=4
AI_COMPARE_GEMINI_TPM=6000
AI_COMPARE_GROQ_RPM=4
AI_COMPARE_GROQ_TPM=6000
AI_COMPARE_OLLAMA_RPM=4
AI_COMPARE_OLLAMA_TPM=6000
# Optional existing Python executable with compatible CUDA/inference dependencies.
# Empty uses the app's uv environment. AI remains a separate owned process.
AI_PYTHON_EXECUTABLE=
# Optional compose inference dependencies; weights stay in read-only mounts.
AI_INFERENCE=false
