# Copy to .env and supply private values. Never commit .env.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DATABASE=nuvia
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
HOST=127.0.0.1
MAIL_MODE=file
# Generate with npm run setup:local (64 hex characters).
MAIL_ENCRYPTION_KEY=
# Optional explicit DNS/TLS compatibility settings; normal defaults are preferred.
MONGODB_DNS_SERVERS=
MONGODB_TLS_MAX_VERSION=
# Real mail: MAIL_MODE=smtp and these settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional public web configuration (never credentials).
NUVIA_API_TARGET=http://127.0.0.1:3001
VITE_PUBLIC_SURVEY_URL=https://nuvia.link/bloom-feedback
