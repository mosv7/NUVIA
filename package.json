{
  "name": "nuvia",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup:local": "node src/backend/scripts/setup-local.mjs",
    "mail:work": "node src/backend/scripts/mail-worker.mjs",
    "dev:backend": "node --watch src/backend/server.mjs",
    "start:backend": "node src/backend/server.mjs",
    "db:check": "node src/backend/scripts/check-db.mjs",
    "db:setup": "node src/backend/scripts/setup-db.mjs",
    "test:backend": "node tests/backend/run.mjs",
    "test:e2e:accounts": "node tests/e2e/run.mjs",
    "test:backend:unit": "node --test tests/backend/config.test.mjs tests/backend/passwords.test.mjs",
    "dev": "vite src/frontend --config src/frontend/vite.config.js --host 127.0.0.1",
    "dev:network": "vite src/frontend --config src/frontend/vite.config.js --host 0.0.0.0",
    "build": "vite build src/frontend --config src/frontend/vite.config.js",
    "preview": "vite preview src/frontend --config src/frontend/vite.config.js --host 127.0.0.1",
    "lint": "eslint src/frontend/src tests/frontend src/backend tests/backend tests/e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config src/frontend/vitest.config.js",
    "test:watch": "vitest --config src/frontend/vitest.config.js",
    "previews": "node src/frontend/scripts/create-previews.mjs",
    "screenshots": "npm run build -- --configLoader runner && node src/frontend/scripts/capture-screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.0.0",
    "@fontsource/manrope": "^5.0.0",
    "@fontsource/noto-sans-arabic": "^5.0.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "mongodb": "7.7.0",
    "nodemailer": "10.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "mongodb-memory-server-core": "11.3.0",
    "playwright": "1.62.1",
    "prettier": "^3.9.10",
    "supertest": "7.3.1",
    "vitest": "^4.1.11"
  }
}
